# ─────────────────────────────────────────────────────────────────────────────
# Audity — Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Generate ADMIN_URL (obfuscated admin path):
#   python -c "import secrets; print(secrets.token_hex(8) + '/')"
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_command_above
DEBUG=False
ALLOWED_HOSTS=Host,IP
TIME_ZONE=Africa/Lagos

# ── Admin URL (security: obfuscate from default /admin/) ──────────────────────
ADMIN_URL=CHANGE_ME_random_hex_path/

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=test_name
DB_USER=db_user
DB_PASSWORD=CHANGE_ME_use_a_strong_random_password
DB_HOST=your_guess
DB_PORT=another_guess
DB_CONN_MAX_AGE=0

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://URL/0
CELERY_BROKER_URL=redis://URL/1
CELERY_RESULT_BACKEND=redis://URL:PORT/2

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=00
JWT_REFRESH_DAYS=0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=cors://host,http://URL:PORT,http://IP:PORT

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=haha_nice_try

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.email.host
EMAIL_PORT=PORT
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Cloud Media Storage (S3-compatible) ───────────────────────────────────────
# Set USE_S3=True for production deployments (local disk is ephemeral on cloud)
# Works with: AWS S3, Cloudflare R2 (recommended — free 10 GB), DigitalOcean Spaces
USE_S3=True_or_False
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=bucket_name
S3_REGION=region
# Cloudflare R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
# DigitalOcean: https://nyc3.digitaloceanspaces.com  |  AWS S3: leave blank
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=

# ── Error Tracking ────────────────────────────────────────────────────────────
SENTRY_DSN=
