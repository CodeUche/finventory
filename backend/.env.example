# ─────────────────────────────────────────────────────────────────────────────
# Audity — Backend Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Generate ADMIN_URL (obfuscated admin path):
#   python -c "import secrets; print(secrets.token_hex(8) + '/')"
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_command_above
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Lagos

# ── Admin URL (security: obfuscate from default /admin/) ──────────────────────
ADMIN_URL=CHANGE_ME_random_hex_path/

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=finventory
DB_USER=finv_app
DB_PASSWORD=CHANGE_ME_use_a_strong_random_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=tauri://localhost,http://localhost:3000,http://127.0.0.1:3000

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Error Tracking ────────────────────────────────────────────────────────────
SENTRY_DSN=
