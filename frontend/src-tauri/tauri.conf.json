{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Audity",
  "version": "0.3.7",
  "identifier": "com.audity.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Audity",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://js.paystack.co; style-src 'self'; style-src-elem 'self' https://js.paystack.co; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://js.paystack.co; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000 https:; object-src 'none'; frame-src blob: 'self' https://checkout.paystack.com; base-uri 'self'; form-action 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1QTJFMDU5RjMxMDBGNkYKUldSdkR4RHpXZUNpWmUzYjV0UFNUOUVFR3hrb3ZnQVBpSGl6RllieHV6R24yUEY5UFc2cmY0V1MK",
      "endpoints": [
        "https://get-audity.vercel.app/latest.json"
      ]
    }
  }
}
