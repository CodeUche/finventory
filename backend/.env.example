# ─────────────────────────────────────────────────────────────────────────────
# Audity Backend — Environment Variables Reference
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core Django ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ADMIN_URL=admin/

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_NAME=finventory
DB_USER=finv_app
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ─── Paystack (Billing / Nigerian bank account resolution) ────────────────────
# Get both keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ─── Groq AI (Financial Assistant) ───────────────────────────────────────────
# Free API — get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# ─── Field-level Encryption ───────────────────────────────────────────────────
# Dedicated encryption key for EncryptedCharField (recommended for production).
# If not set, falls back to SECRET_KEY.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIELD_ENCRYPTION_KEY=

# ─── FIRS E-Invoicing (DigiTax by Namiri Technology Ltd) ─────────────────────
# DigiTax is the NITDA-accredited System Integrator + Access Point Provider (SI+APP)
# that mediates all submissions between Audity and the FIRS FIRSMBS e-invoicing system.
#
# How to obtain credentials:
#   1. Register at https://dashboard.digitax.tech
#   2. Create an application and copy the API key
#   3. Use the SANDBOX key for development; switch to production key at go-live
#
# Per-org API keys are also stored encrypted in FirsConfig.app_api_key (EncryptedCharField).
# The env var below is the platform-level fallback for single-tenant / development use.
#
DIGITAX_APP_API_KEY=
DIGITAX_BASE_URL=https://api.digitax.tech/ng/v1
DIGITAX_SANDBOX_URL=https://api-dev.digitax.tech/ng/v1
# Webhook HMAC secret — register the SAME value on your DigiTax dashboard.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DIGITAX_WEBHOOK_SECRET=
