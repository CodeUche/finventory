{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:8000/**" },
        { "url": "http://127.0.0.1:8000/**" },
        { "url": "https://audity-backend-production-30f9.up.railway.app/**" }
      ]
    },
    "dialog:allow-save",
    "fs:allow-write-file",
    "shell:allow-open",
    "updater:default",
    "process:default"
  ]
}
