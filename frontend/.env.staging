# Staging (web): points at the local staging API from docker-compose.staging.yml
#
# Bring the backend up first:  ./scripts/staging.sh up
# Then:                        npm run dev:staging   ->  http://localhost:5174
#
# Nothing in this file is a secret, which is why it is committed: it only names
# a localhost port. It deliberately carries NO PostHog key, because a staging
# click-through must not land in the production analytics project and skew
# real product numbers.
VITE_API_BASE_URL=http://localhost:8001/api/v1

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
