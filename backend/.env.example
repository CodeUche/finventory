# ─────────────────────────────────────────────────────────────────────────────
# Audity — Backend Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Generate ADMIN_URL (obfuscated admin path):
#   python -c "import secrets; print(secrets.token_hex(8) + '/')"
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_command_above
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
BACKEND_URL=https://api.auditytechnologies.com
FRONTEND_URL=https://www.auditytechnologies.com
TIME_ZONE=Africa/Lagos

# ── Admin URL (security: obfuscate from default /admin/) ──────────────────────
ADMIN_URL=CHANGE_ME_random_hex_path/

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=finventory
DB_USER=finv_app
DB_PASSWORD=CHANGE_ME_use_a_strong_random_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=tauri://localhost,http://localhost:3000,http://127.0.0.1:3000

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# SECURITY RULES:
#   1. EMAIL_HOST_PASSWORD must NEVER be your main account password.
#      Use an app-specific password or SMTP API key instead:
#        - Gmail:     myaccount.google.com/apppasswords  (16-char app password)
#        - Outlook:   account.live.com/proofs/Manage/additional  (app password)
#        - SendGrid:  use "apikey" as EMAIL_HOST_USER, API key as EMAIL_HOST_PASSWORD
#        - Mailgun:   use SMTP credentials from Mailgun dashboard (not your login)
#        - Postmark:  use "POSTMARK_API_TEST" or server API token
#   2. Rotate EMAIL_HOST_PASSWORD immediately if it is ever exposed or committed.
#   3. Use a dedicated sending address (e.g. noreply@yourdomain.com), never a
#      personal inbox.  The domain must be verified with your email provider.
#   4. If you are not sending emails yet, leave EMAIL_HOST blank — the server will
#      start without email and log a warning instead of failing.
#
# ── Brevo (smtp-relay.brevo.com) — current provider ───────────────────────────
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=your_brevo_smtp_login@smtp-brevo.com   ← from Brevo SMTP settings page
#   EMAIL_HOST_PASSWORD=your-brevo-smtp-key                 ← Brevo SMTP key (not API key)
#
# ── SendGrid alternative ───────────────────────────────────────────────────────
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=apikey
#   EMAIL_HOST_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# ── Gmail app password (testing only — do NOT use in production) ──────────────
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx   ← 16-char app password, NOT your Gmail password
#
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_your_brevo_smtp_login@smtp-brevo.com
EMAIL_HOST_PASSWORD=CHANGE_ME_your_smtp_password
DEFAULT_FROM_EMAIL=noreply@CHANGE_ME_your_verified_domain.com

# ── AI Features (Groq — free, works globally including Nigeria) ──────────────
# Powers: "Explain My Money" AI assistant + AI Bank Reconciliation
# Get your free API key at https://console.groq.com/keys
# Free tier: 30 req/min, 14,400 req/day — no billing, no region restrictions.
# Leave blank to disable AI features.
GROQ_API_KEY=

# ── Error Tracking ────────────────────────────────────────────────────────────
SENTRY_DSN=
