# Staging (Tauri desktop): the same local staging API, built as a desktop app.
#
# A separate mode from `staging` on purpose: vite.config.ts treats
# staging-desktop as a Tauri build and switches the PWA service worker OFF,
# because in WebView2 the service worker strips the Authorization header from
# cross-origin requests and every authenticated call comes back 401.
#
#   ./scripts/staging.sh up
#   npm run tauri:build:staging
#
# The desktop build talks to http://localhost:8001 directly, so the staging
# CORS list must contain http://tauri.localhost, and it does. That missing
# entry is exactly what silently broke desktop login on production.
VITE_API_BASE_URL=http://localhost:8001/api/v1

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
