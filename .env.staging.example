# ─────────────────────────────────────────────────────────────────────────────
# Audity staging environment template
#
# You do not normally copy this by hand. `./scripts/staging.sh up` creates
# .env.staging from this file on first run and fills the three generated values
# (SECRET_KEY, FIELD_ENCRYPTION_KEY, DB_PASSWORD) with fresh random secrets.
#
# These secrets are deliberately NOT production's. Staging refuses to start
# against a hosted database, and a copied production .env would fail that check
# as well as this file's own guards. See backend/config/settings/staging.py.
#
# .env.staging itself is gitignored. This template is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Generated by scripts/staging.sh. Must be 40+ and 32+ characters respectively.
SECRET_KEY=GENERATED_ON_FIRST_RUN
FIELD_ENCRYPTION_KEY=GENERATED_ON_FIRST_RUN
DEBUG=False
TIME_ZONE=Africa/Lagos

# Staging serves plain HTTP on localhost, so these are the only hosts it needs.
# `api-staging` and `host.docker.internal` let containers reach it by name.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api-staging,host.docker.internal

# Unlike production this stays at the default. There is nothing to hide from on
# a stack that is not reachable from outside this machine, and an obfuscated
# path you have to look up is one more reason not to use staging.
ADMIN_URL=admin/

# ── Database ─────────────────────────────────────────────────────────────────
# These values are the HOST view: what `manage.py` uses when you run Django
# natively against the staging database. docker-compose.staging.yml overrides
# DB_HOST/DB_PORT to db:5432 for the containers.
DB_NAME=audity_staging
DB_USER=audity_staging
DB_PASSWORD=GENERATED_ON_FIRST_RUN
DB_HOST=localhost
DB_PORT=5433
DB_CONN_MAX_AGE=0

# Set to True only if you knowingly want staging pointed at a hosted database.
# Leave it alone: the default refuses one, which is what stops test data ever
# landing in a customer's books.
STAGING_ALLOW_REMOTE_DB=False

# ── Redis ────────────────────────────────────────────────────────────────────
# Host view again; compose overrides these to the redis service.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# ── JWT ──────────────────────────────────────────────────────────────────────
# Same lifetimes as production, so a token expiry bug shows up here first.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Staging frontend ports are 5174 (vite dev) and 4174 (vite preview), kept off
# the dev stack's 5173/4173. tauri.localhost is the desktop build's real origin
# on Windows, and the entry whose absence broke desktop login on production.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174,http://tauri.localhost,tauri://localhost,capacitor://localhost

# ── Throttling ───────────────────────────────────────────────────────────────
# Real limits are active, just raised (see staging.py). Set this to True only
# when a long automated click-through needs them off entirely.
DISABLE_THROTTLING=False

# ── Email ────────────────────────────────────────────────────────────────────
# False routes every message to the container log. Seeded data contains email
# addresses, so leave this off unless you are specifically testing delivery,
# and then use your own address, never a seeded one.
STAGING_ALLOW_REAL_EMAIL=False
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=staging@audity.test

# ── Error tracking ───────────────────────────────────────────────────────────
# A SEPARATE Sentry project, or empty. Never paste the production DSN here:
# staging exists to generate errors, and they must not page anyone.
STAGING_SENTRY_DSN=

# ── Object storage ───────────────────────────────────────────────────────────
# Staging always writes uploads to local disk. USE_S3 is ignored by
# staging.py, and is kept here only to make that explicit to anyone reading.
USE_S3=False

# ── Payments ─────────────────────────────────────────────────────────────────
# Paystack TEST key only (pk_test / sk_test). A live key here would charge real
# cards from a test run.
PAYSTACK_SECRET_KEY=

# ── Seeded staging sign-in ───────────────────────────────────────────────────
# `./scripts/staging.sh seed` creates accounts on a .test domain, which RFC 2606
# reserves and nothing routes, so no mail can ever reach them. The password is
# generated into your own .env.staging on first run and printed by the seed
# command. No working credential is committed to this repository, even one that
# only unlocks throwaway local accounts.
STAGING_SEED_PASSWORD=GENERATED_ON_FIRST_RUN
