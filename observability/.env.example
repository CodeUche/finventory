# Copy to .env and adjust. Used by docker-compose.yml in this folder.

# ── Grafana admin login ──
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# ── Audit / business dashboards + postgres-exporter target ──
# These point the "Audit Postgres" Grafana datasource AND the postgres-exporter at
# the PRODUCTION Railway Postgres. Use the public TCP proxy endpoint Railway gives
# you (Railway → Postgres service → Connect → "Public Network").
#
# The DB role MUST bypass RLS (row-level security) or audit queries return 0 rows.
# Create a read-only role first — see README.md → "Audit Postgres datasource".
AUDIT_DB_HOST=<railway-proxy-host>     # e.g. containers-us-west-xx.railway.app
AUDIT_DB_PORT=<railway-proxy-port>     # e.g. 6543
AUDIT_DB_NAME=railway                  # Railway's default DB name is usually "railway"
AUDIT_DB_USER=grafana_ro               # read-only, BYPASSRLS role (see README)
AUDIT_DB_PASSWORD=<password>
AUDIT_DB_SSLMODE=require                # Railway requires SSL; use "disable" only for a local DB

# ── Alert email delivery (optional) ──
# Fill these to receive Grafana alert notifications by email (contact point "audity-default").
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=alerts@audity.app
GF_SMTP_FROM_NAME=Audity Grafana
# Where alert emails are sent (used by contactpoints.yml):
ALERT_EMAIL_TO=you@audity.app

# ── Grafana Cloud Loki (production logs, pushed by Locomotive on Railway) ──
# From Grafana Cloud → your stack → Details → Loki ("Send Logs").
# The token is an Access Policy token with logs:write (+ logs:read so Grafana can
# display). URL is the base host (no /loki/... path).
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net
GRAFANA_CLOUD_LOKI_USER=1234567
GRAFANA_CLOUD_LOKI_TOKEN=glc_xxxxxxxx
# Keep TLS verification ON (secure default). Set to true ONLY if your machine
# intercepts TLS (corporate proxy / some antivirus) and Grafana can't verify the
# grafana.net cert — otherwise leave it false.
LOKI_TLS_SKIP_VERIFY=false
